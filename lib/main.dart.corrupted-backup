            unit_id,
            full_name,
            email,
            phone,
            account_status,
            move_in_date,
            properties (
              id,
              name,
              description,
              location,
              address,
              phone,
              email,
              county,
              subcounty
            ),
            units (
              id,
              unit_number,
              unit_type,
              rent,
              monthly_rent,
              status
            )
          ''')
